{
        "$schema": "./node_modules/wrangler/config-schema.json",
        "name": "amir-btc-assistant-api",
        "main": "worker-proxy.js",
        "compatibility_date": "2026-06-27",
        "compatibility_flags": [
                "nodejs_compat"
        ],
        "ai": {
                "binding": "AI"
        },
        "observability": {
                "enabled": true,
                "head_sampling_rate": 1
        },
        "triggers": {
                "crons": [
                        "* * * * *",
                        "*/5 * * * *",
                        "*/15 * * * *"
                ]
        },
        "kv_namespaces": [
                {
                        "binding": "JOIN_CACHE",
                        "id": "TODO_CREATE_DEV_NAMESPACE"
                },
                {
                        "binding": "APP_CACHE",
                        "id": "TODO_CREATE_DEV_NAMESPACE"
                },
                {
                        "binding": "RATE_LIMITS",
                        "id": "TODO_CREATE_DEV_NAMESPACE"
                },
                {
                        "binding": "SESSION_CACHE",
                        "id": "TODO_CREATE_DEV_NAMESPACE"
                }
        ],
        "durable_objects": {
                "bindings": [
                        {
                                "name": "PRESENCE_DO",
                                "class_name": "PresenceDO"
                        }
                ]
        },
        "migrations": [
                {
                        "tag": "v1",
                        "new_sqlite_classes": ["PresenceDO"]
                }
        ],
        "vars": {
                "APP_ENV": "development",
                "ALERTS_CRON_ENABLED": "false",
                "JOIN_CACHE_TTL": 1800,
                "NEWS_CACHE_TTL": 86400,
                "CALENDAR_CACHE_TTL": 600,
                "CHART_EXCHANGE_CACHE_TTL": 3600,
                "SESSION_TTL": 240,
                "AI_DAILY_MESSAGE_LIMIT": 50,
                "AI_DAILY_IMAGE_LIMIT": 3,
                "AI_COOLDOWN_SECONDS": 4,
                "REFERRAL_TOKENS_PER_INVITE": 3,
                "BOT_USERNAME": "Amir_BTC_AssistantBot",
                "ZAI_API_KEY": "Z.ai",
                "ZAI_BASE_URL": "https://internal-api.z.ai/v1"
        },
        "env": {
                "staging": {
                        "name": "amir-btc-assistant-api-staging",
                        "triggers": {
                                "crons": [
                                        "* * * * *",
                                        "*/5 * * * *",
                                        "*/15 * * * *",
                                        "*/30 * * * *"
                                ]
                        },
                        "kv_namespaces": [
                                {
                                        "binding": "JOIN_CACHE",
                                        "id": "35b0badcf95343618a2b3ef1a7f2d551"
                                },
                                {
                                        "binding": "APP_CACHE",
                                        "id": "e5c68aa04c034a319adf2630c4f24a6d"
                                },
                                {
                                        "binding": "RATE_LIMITS",
                                        "id": "5bfe54bc3fdb43ed9ff34fb8fa0e1b17"
                                },
                                {
                                        "binding": "SESSION_CACHE",
                                        "id": "6de016b566f3404e832bb98895a60e85"
                                }
                        ],
                        "durable_objects": {
                                "bindings": [
                                        {
                                                "name": "PRESENCE_DO",
                                                "class_name": "PresenceDO"
                                        }
                                ]
                        },
                        "migrations": [
                                {
                                        "tag": "v1",
                                        "new_sqlite_classes": ["PresenceDO"]
                                }
                        ],
                        "vars": {
                                "APP_ENV": "staging",
                                "ALERTS_CRON_ENABLED": "false",
                                "JOIN_CACHE_TTL": 1800,
                                "NEWS_CACHE_TTL": 86400,
                                "CALENDAR_CACHE_TTL": 600,
                                "CHART_EXCHANGE_CACHE_TTL": 3600,
                                "SESSION_TTL": 240,
                                "AI_DAILY_MESSAGE_LIMIT": 50,
                                "AI_DAILY_IMAGE_LIMIT": 3,
                                "AI_COOLDOWN_SECONDS": 4,
                                "REFERRAL_TOKENS_PER_INVITE": 3,
                                "BOT_USERNAME": "Amir_BTC_AssistantBot",
                                "ZAI_API_KEY": "Z.ai",
                                "ZAI_BASE_URL": "https://internal-api.z.ai/v1"
                        },
                        "hyperdrive": [
                                {
                                        "binding": "HYPERDRIVE",
                                        "id": "417477e0da0d44a4a8d464399e39e072"
                                }
                        ]
                },
                "production": {
                        "name": "amir-btc-assistant-api-production",
                        "ai": {
                                "binding": "AI"
                        },
                        "triggers": {
                                "crons": [
                                        "* * * * *",
                                        "*/5 * * * *",
                                        "*/15 * * * *"
                                ]
                        },
                        "kv_namespaces": [
                                {
                                        "binding": "JOIN_CACHE",
                                        "id": "61813c11a2064a67ac994dc62c30a990"
                                },
                                {
                                        "binding": "APP_CACHE",
                                        "id": "a37aa8e1368e4a6a92e666273936673b"
                                },
                                {
                                        "binding": "RATE_LIMITS",
                                        "id": "03bfb4851d09452489d631e038f9e791"
                                },
                                {
                                        "binding": "SESSION_CACHE",
                                        "id": "1ba0ebc1fe8042259ea0824bd3b50b6a"
                                }
                        ],
                        "durable_objects": {
                                "bindings": [
                                        {
                                                "name": "PRESENCE_DO",
                                                "class_name": "PresenceDO"
                                        }
                                ]
                        },
                        "migrations": [
                                {
                                        "tag": "v1",
                                        "new_sqlite_classes": ["PresenceDO"]
                                }
                        ],
                        "vars": {
                                "APP_ENV": "production",
                                "ALERTS_CRON_ENABLED": "true",
                                "JOIN_CACHE_TTL": 1800,
                                "NEWS_CACHE_TTL": 1800,
                                "CALENDAR_CACHE_TTL": 600,
                                "CHART_EXCHANGE_CACHE_TTL": 3600,
                                "SESSION_TTL": 240,
                                "AI_DAILY_MESSAGE_LIMIT": 50,
                                "AI_DAILY_IMAGE_LIMIT": 3,
                                "AI_COOLDOWN_SECONDS": 4,
                                "REFERRAL_TOKENS_PER_INVITE": 3,
                                "BOT_USERNAME": "Amir_BTC_AssistantBot",
                                "NEWS_PROVIDER_OPENROUTER": "true",
                                "GROQ_RPM_LIMIT": 20,
                                "ZAI_API_KEY": "Z.ai",
                                "ZAI_BASE_URL": "https://internal-api.z.ai/v1"
                        },
                        "hyperdrive": [
                                {
                                        "binding": "HYPERDRIVE",
                                        "id": "f4b69c06c1e84d98b7c4b5720efe4b41"
                                }
                        ]
                }
        }
}